---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/**
	 * Set only on the actual profile page (the homepage), which wraps the
	 * Person schema in ProfilePage. Bump the date whenever that page's
	 * content changes. Other pages get the bare Person schema.
	 */
	profileDateModified?: string;
	/**
	 * Set only on pages whose primary content is a video (currently
	 * /live). Switches og:type to video.other and adds og:video /
	 * Twitter Player Card tags pointing at the same embeddable iframe URL
	 * already rendered as the page's visible player, so there's no separate
	 * video asset to host or keep in sync.
	 */
	video?: {
		embedUrl: string;
		width: number;
		height: number;
		posterUrl: string;
	};
	/** Set on pages excluded from the public surface, e.g. /elements/. */
	noindex?: boolean;
}

const { title, description, profileDateModified, video, noindex } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.jpg", Astro.site);

const year = new Date().getFullYear();

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Brandon Davenport",
	url: "https://itsbrandond.com",
	image: ogImageURL.toString(),
	sameAs: [
		"https://linkedin.com/in/itsbrandond",
		"https://x.com/itsbrandond",
		"https://github.com/itsbrandondev",
	],
	affiliation: {
		"@type": "Organization",
		name: "Hgraph",
		url: "https://hgraph.com",
	},
	memberOf: {
		"@type": "Organization",
		name: "Hiero Technical Steering Committee",
		url: "https://hiero.org/tsc",
	},
};

const schema = profileDateModified
	? {
			"@context": "https://schema.org",
			"@type": "ProfilePage",
			dateModified: profileDateModified,
			mainEntity: personSchema,
		}
	: personSchema;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<!--
			One robots meta, two modes: excluded pages get noindex; public pages
			opt into full-size image previews in search results (the default cap
			can shrink them). Keep it a single tag so the modes can't stack.
		-->
		<meta
			name="robots"
			content={noindex ? "noindex, nofollow" : "max-image-preview:large"}
		/>

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!--
			Tints the browser chrome to the page field, so the address bar and the
			page stop disagreeing at the top edge. Honoured by Safari 15+ and by
			Chrome on Android; Firefox ignores it and desktop Chrome applies it
			only to installed apps. Keep it in step with --bg in global.css.
		-->
		<meta name="theme-color" content="#0000cc" />

		<meta property="og:type" content={video ? "video.other" : "website"} />
		<meta property="og:site_name" content="Brandon Davenport" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1920" />
		<meta property="og:image:height" content="1200" />
		<meta
			property="og:image:alt"
			content="Line-art portrait of Brandon Davenport on a blue background"
		/>
		{
			video && (
				<>
					<meta property="og:video" content={video.embedUrl} />
					<meta property="og:video:secure_url" content={video.embedUrl} />
					<meta property="og:video:type" content="text/html" />
					<meta property="og:video:width" content={String(video.width)} />
					<meta property="og:video:height" content={String(video.height)} />
				</>
			)
		}
		<meta
			name="twitter:card"
			content={video ? "player" : "summary_large_image"}
		/>
		<meta name="twitter:site" content="@itsbrandond" />
		<meta name="twitter:creator" content="@itsbrandond" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={video ? video.posterUrl : ogImageURL} />
		{
			video && (
				<>
					<meta name="twitter:player" content={video.embedUrl} />
					<meta name="twitter:player:width" content={String(video.width)} />
					<meta name="twitter:player:height" content={String(video.height)} />
				</>
			)
		}

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(schema)}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="site-header-row">
				<a
					href="/"
					class="site-home"
					aria-current={Astro.url.pathname === "/" ? "page" : undefined}
				>
					itsbrandond
				</a>
				<nav aria-label="Primary">
					<ul class="list-reset">
						<li><a href="/work">Work</a></li>
						<li><a href="/live">Live Stream</a></li>
						<li>
							<a
								href="https://linkedin.com/in/itsbrandond"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="About (opens LinkedIn in a new tab)"
							>
								About<span aria-hidden="true">&#8239;&#8599;</span>
							</a>
						</li>
						<li><a id="connect-open" href="#connect">Connect</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer meta">
			<p>Brandon Davenport, {year}</p>
		</footer>

		<!--
			Opened with showModal() when JS runs, which supplies the focus trap,
			the backdrop, Esc-to-close and background inerting for free. Without
			JS the trigger is a real #connect link and `.modal:target` in
			global.css reveals the panel here, in document flow after the
			footer, so the link is never a dead button. Keep both paths working.
		-->
		<dialog id="connect" class="modal" aria-labelledby="connect-title">
			<h2 id="connect-title">Connect</h2>
			<ul class="list-reset">
				<li><a href="/meet">Book a call</a></li>
				<li><a href="mailto:hey@itsbrandond.com?subject=Hello">Email me</a></li>
				<li>
					<a
						href="https://x.com/itsbrandond"
						rel="me noopener noreferrer"
						target="_blank"
						aria-label="Follow on X">Follow on 𝕏</a
					>
				</li>
				<li>
					<a
						href="https://linkedin.com/in/itsbrandond"
						rel="me noopener noreferrer"
						target="_blank">LinkedIn</a
					>
				</li>
				<li>
					<a
						href="https://github.com/itsbrandondev"
						rel="me noopener noreferrer"
						target="_blank">GitHub</a
					>
				</li>
			</ul>
			<!--
				Targets #main rather than "#": a real destination keeps it a valid
				link, and navigating away from #connect is exactly what un-targets
				the panel in the no-JS path. With JS, the handler closes it instead.
			-->
			<a id="connect-close" class="modal-close meta" href="#main">Close</a>
		</dialog>

		<script is:inline>
			function wireDialog(dialogId, openId, closeId) {
				var dialog = document.getElementById(dialogId);
				var open = document.getElementById(openId);
				var close = document.getElementById(closeId);
				if (!dialog || !open || !close || !dialog.showModal) return;

				open.addEventListener("click", function (event) {
					event.preventDefault();
					dialog.showModal();
				});

				close.addEventListener("click", function (event) {
					event.preventDefault();
					dialog.close();
				});

				// Clicking the backdrop lands on the dialog element itself.
				dialog.addEventListener("click", function (event) {
					if (event.target === dialog) dialog.close();
				});

				dialog.addEventListener("close", function () {
					open.focus();
				});
			}

			wireDialog("connect", "connect-open", "connect-close");
		</script>
	</body>
</html>
