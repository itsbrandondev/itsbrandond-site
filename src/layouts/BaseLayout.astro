---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/**
	 * Set only on the actual profile page (the homepage), which wraps the
	 * Person schema in ProfilePage. Bump the date whenever that page's
	 * content changes. Other pages get the bare Person schema.
	 */
	profileDateModified?: string;
}

const { title, description, profileDateModified } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.jpg", Astro.site);

const year = new Date().getFullYear();

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Brandon Davenport",
	url: "https://itsbrandond.com",
	image: ogImageURL.toString(),
	sameAs: [
		"https://linkedin.com/in/itsbrandond",
		"https://x.com/itsbrandond",
		"https://github.com/itsbrandondev",
	],
	affiliation: {
		"@type": "Organization",
		name: "Hgraph",
		url: "https://hgraph.com",
	},
	memberOf: {
		"@type": "Organization",
		name: "Hiero Technical Steering Committee",
		url: "https://hiero.org/tsc",
	},
};

const schema = profileDateModified
	? {
			"@context": "https://schema.org",
			"@type": "ProfilePage",
			dateModified: profileDateModified,
			mainEntity: personSchema,
		}
	: personSchema;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<meta name="generator" content={Astro.generator} />

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(schema)}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<nav aria-label="Primary">
				<ul>
					<li>
						<a
							href="/work"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Work (opens LinkedIn in a new tab)"
						>
							Work<span aria-hidden="true">&#8239;&#8599;</span>
						</a>
					</li>
					<li><a href="/live-show">Live show</a></li>
					<li><a id="contact-open" href="#contact">Contact</a></li>
				</ul>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<p>Brandon Davenport, {year}</p>
		</footer>

		<!--
			Opened with showModal() when JS runs, which supplies the focus trap,
			the backdrop, Esc-to-close and background inerting for free. Without
			JS the trigger is a real #contact link and `dialog:target` in
			global.css reveals the panel in flow, so the links are never a dead
			button. Keep both paths working.
		-->
		<dialog id="contact" aria-labelledby="contact-title">
			<h2 id="contact-title">Get in touch</h2>
			<ul>
				<li><a href="/meet">Book a call</a></li>
				<li><a href="mailto:hey@itsbrandond.com?subject=Hello">Email me</a></li>
				<li>
					<a href="https://x.com/itsbrandond" rel="me">X</a>
				</li>
				<li>
					<a href="https://linkedin.com/in/itsbrandond" rel="me">LinkedIn</a>
				</li>
				<li>
					<a href="https://github.com/itsbrandondev" rel="me">GitHub</a>
				</li>
			</ul>
			<!--
				Targets #main rather than "#": a real destination keeps it a valid
				link, and navigating away from #contact is exactly what un-targets
				the panel in the no-JS path. With JS, the handler closes it instead.
			-->
			<a id="contact-close" class="contact-close" href="#main">Close</a>
		</dialog>

		<script is:inline>
			(function () {
				var dialog = document.getElementById("contact");
				var open = document.getElementById("contact-open");
				var close = document.getElementById("contact-close");
				if (!dialog || !open || !close || !dialog.showModal) return;

				open.addEventListener("click", function (event) {
					event.preventDefault();
					dialog.showModal();
				});

				close.addEventListener("click", function (event) {
					event.preventDefault();
					dialog.close();
				});

				// Clicking the backdrop lands on the dialog element itself.
				dialog.addEventListener("click", function (event) {
					if (event.target === dialog) dialog.close();
				});

				dialog.addEventListener("close", function () {
					open.focus();
				});
			})();
		</script>
	</body>
</html>
