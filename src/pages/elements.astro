---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotFoundContent from "../components/NotFoundContent.astro";
import WorkListItem from "../components/WorkListItem.astro";
import StreamPlayer from "../components/StreamPlayer.astro";
import StreamThumbnail from "../components/StreamThumbnail.astro";
import { workItems } from "../data/work";
import { latestStream, streams } from "../data/streams";

const title = "Elements | Brandon Davenport";
const description =
	"Internal UI inventory: every font, spacing, and layout pattern the site uses, in one place. Not part of the public site.";

// A spread of link counts (0, 1, a few, many) so the WorkListItem grid
// reads with real variety instead of one link and none.
const workSpecimenIds = [
	"cross-chain-bridge", // no links
	"hedera-wallet-connect", // 1 link
	"hederacon-2025", // 2 links
	"hashgraph-enthusiasts-show", // 4 links
];
// find() is total for these ids; the fallback is what tells the type checker so.
const workSpecimens = workSpecimenIds.map(
	(id) => workItems.find((item) => item.id === id) ?? workItems[0],
);

const pastStreams = streams.slice(1);

// Container widths the ramp renders each component at, so the sandbox can show
// container-driven layout without resizing the window.
const rampWidths = [320, 480, 720, 912];
---

<BaseLayout title={title} description={description} noindex={true}>
	<h1>Elements</h1>
	<p class="lede">
		Every UI pattern the site uses, in one place: a sandbox to iterate fonts,
		spacing, and layout against before touching a real page.
	</p>

	<section>
		<h2>Body text and links</h2>
		<p>
			Body prose reads at the base type size. It links inline to the <a
				href="/work">work page</a
			>, and out to{" "}
			<a
				href="https://linkedin.com/in/itsbrandond"
				target="_blank"
				rel="noopener noreferrer"
			>
				LinkedIn<span aria-hidden="true">&#8239;&#8599;</span></a
			>{" "}
			the same way the header's About link does.
		</p>
		<p class="meta">
			Muted meta text: the pattern used for timestamps and secondary detail.
		</p>
	</section>

	<section class="cooking">
		<h2>List</h2>
		<ul class="bullet-list">
			<li>An example list item.</li>
			<li>Another example list item.</li>
		</ul>
	</section>

	<section class="not-found">
		<h2>404 content</h2>
		<NotFoundContent />
	</section>

	<section class="breakout">
		<h2>Work list item</h2>
		<ul class="specimen-list list-reset">
			{workSpecimens.map((item) => <WorkListItem item={item} />)}
		</ul>
	</section>

	<section class="breakout">
		<h2>Stream player</h2>
		<StreamPlayer stream={latestStream} />
	</section>

	<section>
		<h2>Stream thumbnail</h2>
		<ul class="specimen-list list-reset">
			{pastStreams.map((stream) => <StreamThumbnail stream={stream} />)}
		</ul>
	</section>

	<section>
		<h2>Headings</h2>
		<p class="meta">
			Visible page h1, used on <code>/work</code>, <code>/elements</code>, and{
				" "
			}
			<code>/404</code>. The homepage and <code>/live-show</code> use a{" "}
			<code>.visually-hidden</code> h1 instead, so it carries no visible size to demonstrate
			here.
		</p>
		<h1>A visible page h1</h1>
		<p class="meta">Section h2, used everywhere.</p>
		<h2>A section h2</h2>
		<p class="meta">
			The Connect dialog's <code>.modal h2</code>, same size as above with a
			larger bottom margin.
		</p>
		<div class="modal">
			<h2>A modal h2</h2>
		</div>
	</section>

	<section>
		<h2>Tokens</h2>
		<p class="meta">
			The type scale, each step against its leading. Sizes are fixed, not fluid.
		</p>
		<ul class="specimen-list list-reset">
			<li>
				<span class="swatch-lg">Aa</span>
				<span class="meta">--text-lg</span>
			</li>
			<li>
				<span class="swatch-md">Aa</span>
				<span class="meta">--text-md</span>
			</li>
			<li><span>Aa</span> <span class="meta">--text-base</span></li>
			<li><span class="meta">Aa &mdash; --text-sm</span></li>
		</ul>
		<p class="meta">
			The spacing tiers used for page rhythm: 64 between sections, 48 between
			blocks, 24 between elements.
		</p>
		<ul class="specimen-list list-reset">
			<li>
				<span class="bar bar-8"></span>
				<span class="meta">--space-8, 64</span>
			</li>
			<li>
				<span class="bar bar-7"></span>
				<span class="meta">--space-7, 48</span>
			</li>
			<li>
				<span class="bar bar-5"></span>
				<span class="meta">--space-5, 24</span>
			</li>
		</ul>
		<p class="meta">
			The palette. --muted and --rule are translucent white, so each chip shows
			what that token composites to over the field, not a fixed value.
		</p>
		<ul class="specimen-list list-reset">
			<li>
				<span class="chip chip-bg"></span>
				<span class="meta">--bg, the field</span>
			</li>
			<li>
				<span class="chip chip-fg"></span>
				<span class="meta">--fg, body text at 11.22:1</span>
			</li>
			<li>
				<span class="chip chip-muted"></span>
				<span class="meta">--muted, secondary text at 7.22:1</span>
			</li>
			<li>
				<span class="chip chip-rule"></span>
				<span class="meta">--rule, hairlines and fills</span>
			</li>
		</ul>
		<p class="meta">
			The two patterns the field forces, neither of which shows in a static
			screenshot: select the line below, and tab to the link.
		</p>
		<ul class="specimen-list list-reset">
			<li>Select this line to see the ::selection treatment.</li>
			<li><a href="/work">Tab to this link to see the focus ring</a></li>
		</ul>
	</section>

	<section class="breakout">
		<h2>Container width ramp</h2>
		<p class="meta">
			The card grid rendered at four fixed container widths, using work list
			items as example content (the archive switched to a compact row list and
			no longer uses this pattern). Column count follows the container, so these
			stay put while the window resizes. This is the case a single full-width
			column cannot show.
		</p>
		{
			rampWidths.map((w) => (
				<div class="ramp-step">
					<span class="meta">{w}px</span>
					<div class="ramp-box" style={`width: ${w}px`}>
						<ul class="list-reset card-grid">
							{workSpecimens.map((item) => (
								<WorkListItem item={item} />
							))}
						</ul>
					</div>
				</div>
			))
		}
	</section>
</BaseLayout>

<style>
	section + section {
		margin-top: var(--space-8);
	}

	.meta {
		margin: var(--space-3) 0 0;
	}

	/*
	 * Bridges the Headings section's caption-then-specimen order, which
	 * inverts the site's usual heading-then-caption flow: h1/h2 own no top
	 * margin and .meta owns no bottom margin, so nothing spaces them apart
	 * without this. Matches h1's own bottom-margin value for symmetry.
	 */
	.meta + h1,
	.meta + h2,
	.meta + .modal {
		margin-top: var(--space-4);
	}

	.specimen-list {
		display: grid;
		gap: var(--space-5);
	}

	.swatch-lg {
		font-size: var(--text-lg);
		line-height: var(--leading-tight);
	}

	.swatch-md {
		font-size: var(--text-md);
		line-height: var(--leading-snug);
	}

	.bar {
		display: inline-block;
		height: 0.5rem;
		vertical-align: middle;
		background: var(--rule);
	}

	/*
	 * Same inline-block shape as .bar, given height so a colour reads as an
	 * area rather than a line. The border is what makes the --bg chip visible
	 * at all, since it is the field the page is already painted in.
	 */
	.chip {
		display: inline-block;
		width: var(--space-8);
		height: var(--space-5);
		vertical-align: middle;
		border: 1px solid var(--fg);
	}

	.chip-bg {
		background: var(--bg);
	}

	.chip-fg {
		background: var(--fg);
	}

	.chip-muted {
		background: var(--muted);
	}

	.chip-rule {
		background: var(--rule);
	}

	.bar-8 {
		width: var(--space-8);
	}

	.bar-7 {
		width: var(--space-7);
	}

	.bar-5 {
		width: var(--space-5);
	}

	.ramp-step + .ramp-step {
		margin-top: var(--space-7);
	}

	/*
	 * The ramp deliberately sets a fixed container width so the components
	 * inside respond to it rather than to the window. max-width keeps a wide
	 * step from overflowing the page on a narrow screen, which would otherwise
	 * be the one place this sandbox breaks the rail.
	 */
	.ramp-box {
		max-width: 100%;
		margin-top: var(--space-2);
		outline: 1px dashed var(--rule);
		outline-offset: var(--space-2);
	}
</style>
