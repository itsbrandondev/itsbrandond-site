---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotFoundContent from "../components/NotFoundContent.astro";
import WorkListItem from "../components/WorkListItem.astro";
import StreamPlayer from "../components/StreamPlayer.astro";
import StreamThumbnail from "../components/StreamThumbnail.astro";
import { workItems } from "../data/work";
import { latestStream, streams } from "../data/streams";

const title = "Elements | Brandon Davenport";
const description =
	"Internal UI inventory: every font, spacing, and layout pattern the site uses, in one place. Not part of the public site.";

// A spread of link counts (0, 1, a few, many) so the WorkListItem grid
// reads with real variety instead of one link and none.
const workSpecimenIds = [
	"cross-chain-bridge", // no links
	"hedera-wallet-connect", // 1 link
	"hederacon-2025", // 2 links
	"hashgraph-enthusiasts-show", // 4 links
];
const workSpecimens = workSpecimenIds.map(
	(id) => workItems.find((item) => item.id === id) ?? workItems[0],
);

const pastStreams = (streams[1] ? [streams[1], streams[2]] : [streams[0]])
	.filter(Boolean)
	.slice(0, 2);
---

<BaseLayout title={title} description={description} noindex={true}>
	<h1>Elements</h1>
	<p class="intro">
		Every UI pattern the site uses, in one place: a sandbox to iterate fonts,
		spacing, and layout against before touching a real page.
	</p>

	<section>
		<h2>Body text and links</h2>
		<p>
			Body prose reads at the base type size. It links inline to the <a
				href="/work">work page</a
			>, and out to{" "}
			<a
				href="https://linkedin.com/in/itsbrandond"
				target="_blank"
				rel="noopener noreferrer"
			>
				LinkedIn<span aria-hidden="true">&#8239;&#8599;</span></a
			>{" "}
			the same way the header's About link does.
		</p>
		<p class="meta">
			Muted meta text: the pattern used for timestamps and secondary detail.
		</p>
	</section>

	<section>
		<h2>Call to action</h2>
		<p><a class="cta-link" href="/meet">A cta-link anchor</a></p>
		<p><button type="button" class="cta-link">A cta-link button</button></p>
	</section>

	<section class="cooking">
		<h2>List</h2>
		<ul>
			<li>An example list item.</li>
			<li>Another example list item.</li>
		</ul>
	</section>

	<section class="not-found">
		<h2>404 content</h2>
		<NotFoundContent />
	</section>

	<section>
		<h2>Work list item</h2>
		<ul class="specimen-list">
			{workSpecimens.map((item) => <WorkListItem item={item} />)}
		</ul>
	</section>

	<section>
		<h2>Stream player</h2>
		<StreamPlayer stream={latestStream} />
	</section>

	<section>
		<h2>Stream thumbnail</h2>
		<ul class="specimen-list">
			{pastStreams.map((stream) => <StreamThumbnail stream={stream} />)}
		</ul>
	</section>

	<section>
		<h2>Headings</h2>
		<p class="meta">
			Visible page h1, used on <code>/work</code>, <code>/elements</code>, and{
				" "
			}
			<code>/404</code>. The homepage and <code>/live-show</code> use a{" "}
			<code>.visually-hidden</code> h1 instead, so it carries no visible size to demonstrate
			here.
		</p>
		<h1>A visible page h1</h1>
		<p class="meta">Section h2, used everywhere.</p>
		<h2>A section h2</h2>
		<p class="meta">
			The Connect dialog's <code>.modal h2</code>, same size as above with a
			larger bottom margin.
		</p>
		<div class="modal">
			<h2>A modal h2</h2>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		margin-block: 0 var(--space-5);
	}

	section + section {
		margin-top: var(--space-7);
	}

	.meta {
		margin: var(--space-3) 0 0;
		color: var(--muted);
		font-size: var(--text-sm);
	}

	.cooking ul {
		margin: 0;
		padding-left: var(--space-4);
		display: grid;
		gap: var(--space-1);
	}

	/*
	 * Bridges the Headings section's caption-then-specimen order, which
	 * inverts the site's usual heading-then-caption flow: h1/h2 own no top
	 * margin and .meta owns no bottom margin, so nothing spaces them apart
	 * without this. Matches h1's own bottom-margin value for symmetry.
	 */
	.meta + h1,
	.meta + h2,
	.meta + .modal {
		margin-top: var(--space-4);
	}

	/*
	 * Restores an intentional gap between adjacent bare <p> (e.g. the two
	 * cta-link specimens), now that global.css resets <p> margin to 0.
	 * Matches .meta's own top-margin value, the site's caption-gap distance.
	 */
	section p + p {
		margin-top: var(--space-3);
	}

	.specimen-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: var(--space-5);
	}
</style>
