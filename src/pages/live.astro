---
import BaseLayout from "../layouts/BaseLayout.astro";
import StreamPlayer from "../components/StreamPlayer.astro";
import StreamThumbnail from "../components/StreamThumbnail.astro";
import {
	broadcastUrl,
	embedUrl,
	formatDate,
	latestStream,
	streams,
	upcomingStream,
} from "../data/streams";

const title = "Live Stream | Brandon Davenport";
const description =
	"A live show on X: building in public, reacting to technology news, and working through problems on camera. Watch the latest stream and browse past replays.";

// A scheduled broadcast takes the player slot and pushes every replay into the
// archive; with nothing scheduled the newest replay takes it back and the
// archive is everything below it, as before.
const featured = upcomingStream ?? latestStream;
const pastStreams = upcomingStream ? streams : streams.slice(1);

// VideoObject requires name, thumbnailUrl and uploadDate; duration and
// embedUrl are the recommended extras. Google retired podcast rich results,
// so there is deliberately no PodcastSeries here.
//
// Covers the replays only. A scheduled broadcast gets no VideoObject: it has
// no runtime, no thumbnail and no upload date, and three of those are required
// properties, so the only way to emit one is to invent them. Live-stream markup
// is a real option once it has aired and has a thumbnail.
const videoSchema = streams.map((stream) => ({
	"@context": "https://schema.org",
	"@type": "VideoObject",
	name: stream.title,
	description: `Live stream by Brandon Davenport on ${formatDate(stream.date)}.`,
	thumbnailUrl: new URL(stream.thumbnail.src, Astro.site).toString(),
	uploadDate: stream.date,
	duration: stream.durationIso,
	url: broadcastUrl(stream.id),
	embedUrl: embedUrl(stream.id),
}));

// Drives BaseLayout's og:video / Twitter Player Card tags, scoped to this
// page only. Deliberately the newest REPLAY even while a scheduled broadcast
// holds the player slot above: a player card needs a poster frame, and a
// stream that has not aired has none. The replay is still on this page, in the
// archive, so the card keeps pointing at real video rather than at a countdown
// with no thumbnail.
const video = {
	embedUrl: embedUrl(latestStream.id),
	width: 1280,
	height: 720,
	posterUrl: new URL(latestStream.thumbnail.src, Astro.site).toString(),
};
---

<BaseLayout title={title} description={description} video={video}>
	<h1 class="visually-hidden">Recent Live Streams on X</h1>

	<section class="cta">
		<p>
			<a
				href="https://forms.gle/CN7kAXNFPosXUE397"
				target="_blank"
				rel="noopener noreferrer">Get clips &amp; more</a
			>
		</p>
	</section>

	<StreamPlayer stream={featured} />

	{
		pastStreams.length > 0 && (
			<section class="archive">
				<h2>Past streams</h2>
				<ul class="list-reset stream-list" role="list">
					{pastStreams.map((stream) => (
						<StreamThumbnail stream={stream} />
					))}
				</ul>
			</section>
		)
	}

	<section class="about">
		<h2>About the stream</h2>
		<p>
			Live on 𝕏 (Twitter) explaining what I'm building, reacting to the day's
			technology news, digging into things that don't add up, and taking
			questions from chat. We are still building this show together. It is open
			source, which means anyone can share clips freely.
		</p>
	</section>

	<section class="cta-bottom">
		<ul class="list-reset" role="list">
			<li>
				<a
					href="https://forms.gle/CN7kAXNFPosXUE397"
					target="_blank"
					rel="noopener noreferrer">Get clips &amp; more via email</a
				>
			</li>
			<li>
				<a
					href="https://x.com/itsbrandond"
					rel="me noopener noreferrer"
					target="_blank">Get notified on 𝕏 when I'm live</a
				>
			</li>
		</ul>
	</section>

	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(videoSchema)}
	/>
</BaseLayout>

<style>
	.about,
	.archive {
		margin-top: var(--space-8);
	}

	/*
	 * First section under the hidden h1, matching the homepage's .intro gap.
	 * margin-bottom (not the player's own margin-top) sets the gap to the
	 * player below, since the player's <section> is rendered by StreamPlayer,
	 * a different component whose scoped styles this file can't reach. Set to
	 * --space-5 to match the player's own video-to-meta gap (StreamPlayer.astro),
	 * so the gap above the player and the gap below it read the same.
	 */
	.cta {
		margin-top: var(--space-5);
		margin-bottom: var(--space-5);
	}

	.cta p {
		margin: 0;
	}

	.stream-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	/* Matches the lede-to-CTA gap on /work's header (--space-5), rather than
	 * the standard section tier: this list follows straight on from the
	 * paragraph above it, not a new section. */
	.cta-bottom {
		margin-top: var(--space-5);
	}

	.cta-bottom ul {
		display: grid;
		gap: var(--space-2);
	}
</style>
