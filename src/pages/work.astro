---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkListItem from "../components/WorkListItem.astro";
import { workCategories, workItems } from "../data/work";

const title = "Work | Brandon Davenport";
const description =
	"What I've built, shipped, and closed: platform standards, product launches, and deals across the Hedera ecosystem and beyond.";

// Mirrors the rendered copy exactly: no detail here that isn't visible below.
const workSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	itemListElement: workItems.map((item, index) => ({
		"@type": "ListItem",
		position: index + 1,
		item: {
			"@type": "CreativeWork",
			name: item.title,
			description: item.description,
			...(item.links?.[0] ? { url: item.links[0].url } : {}),
		},
	})),
};
---

<BaseLayout title={title} description={description}>
	<h1>Work</h1>
	<p class="lede">
		A fuller look at what I've built, shipped, and closed. I've closed startup
		and enterprise deals, and grew Hgraph from 0-1. I'm open for consulting
		work: tell me what you're working on.
	</p>
	<section class="cta-top">
		<p><a href="/meet">Book a call</a></p>
		<p><a href="mailto:hey@itsbrandond.com?subject=Hello">Email me</a></p>
	</section>

	{
		workCategories.map((category) => (
			<section class="category breakout">
				<h2>{category}</h2>
				<ul class="list-reset card-grid">
					{workItems
						.filter((item) => item.category === category)
						.map((item) => (
							<WorkListItem item={item} />
						))}
				</ul>
			</section>
		))
	}

	<section class="cta">
		<p><a href="/meet">Book a call</a></p>
		<p><a href="mailto:hey@itsbrandond.com?subject=Hello">Email me</a></p>
	</section>

	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(workSchema)}
	/>
</BaseLayout>

<style>
	.cta-top {
		margin-block: 0 var(--space-7);
	}

	.cta-top p {
		margin: 0 0 var(--space-2);
	}

	/* Deliberately past --space-8 (the largest shared tier): these category
	 * blocks are dense card grids, not short prose sections, and read as
	 * cramped at the standard section gap. */
	.category + .category {
		margin-top: 6rem;
	}

	/* A little more room than the global h2 (--space-3) before the card grid. */
	.category h2 {
		margin-bottom: var(--space-5);
	}

	/* Work items carry more text than a stream card, so they get a wider floor. */
	.category > ul {
		--card-min: 20rem;
	}

	.cta {
		margin-top: var(--space-8);
	}

	.cta p {
		margin: 0 0 var(--space-2);
	}
</style>
