---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Work | Brandon Davenport"
	description="A proof-of-work page for Brandon Davenport is on the way. In the meantime, see his LinkedIn or the live show."
>
	<section class="work">
		<h1>Work</h1>
		<p>
			Coming soon: a real look at what I've built and shipped. Until then, <a
				href="https://linkedin.com/in/itsbrandond"
				target="_blank"
				rel="noopener noreferrer">LinkedIn</a
			> has the play-by-play, or catch me <a href="/live-show">live</a>.
		</p>
	</section>
</BaseLayout>

<style>
	.work {
		padding-block: 2rem 4rem;
	}

	.work h1 {
		font-size: 1.5rem;
		margin: 0 0 1rem;
	}

	.work p {
		margin: 0;
	}
</style>
