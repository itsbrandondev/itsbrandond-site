---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkListItem from "../components/WorkListItem.astro";
import { workCategories, workItems } from "../data/work";

const title = "Work | Brandon Davenport";
const description =
	"What I've built, shipped, and closed: platform standards, product launches, and deals across the Hedera ecosystem and beyond.";

// Mirrors the rendered copy exactly: no detail here that isn't visible below.
const workSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	itemListElement: workItems.map((item, index) => ({
		"@type": "ListItem",
		position: index + 1,
		item: {
			"@type": "CreativeWork",
			name: item.title,
			description: item.description,
			...(item.links?.[0] ? { url: item.links[0].url } : {}),
		},
	})),
};
---

<BaseLayout title={title} description={description}>
	<h1>Work</h1>
	<p class="intro">
		A fuller look at what I've built, shipped, and closed. I've closed startup
		and enterprise deals, and grew Hgraph from 0-1. I'm open for consulting
		work: tell me what you're working on.
	</p>
	<p class="cta-top">
		<a href="/meet">Book a call</a>
	</p>

	{
		workCategories.map((category) => (
			<section class="category">
				<h2>{category}</h2>
				<ul>
					{workItems
						.filter((item) => item.category === category)
						.map((item) => (
							<WorkListItem item={item} />
						))}
				</ul>
			</section>
		))
	}

	<section class="cta">
		<p><a href="/meet">Book a call</a></p>
	</section>

	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(workSchema)}
	/>
</BaseLayout>

<style>
	.intro {
		margin-block: 0 var(--space-5);
	}

	.cta-top {
		margin-block: 0 var(--space-6);
	}

	.category + .category {
		margin-top: var(--space-6);
	}

	.category > ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: var(--space-5);
	}

	.cta {
		margin-top: var(--space-7);
	}

	.cta p {
		margin: 0;
	}

	@media (min-width: 64rem) {
		.category {
			max-width: var(--measure-wide);
		}

		.category > ul {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
