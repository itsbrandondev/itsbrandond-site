---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Page not found | Brandon Davenport"
	description="This page doesn't exist."
>
	<section class="not-found">
		<h1>Page not found</h1>
		<p>
			That page isn't here. Try the <a href="/">homepage</a> or the <a
				href="/live-show">live show</a
			>.
		</p>
	</section>
</BaseLayout>

<style>
	.not-found {
		padding-block: 2rem 4rem;
	}

	.not-found h1 {
		font-size: 1.5rem;
		margin: 0 0 1rem;
	}

	.not-found p {
		margin: 0;
	}
</style>
