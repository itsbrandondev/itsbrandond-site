---
import type { WorkItem } from "../data/work";

interface Props {
	item: WorkItem;
}

const { item } = Astro.props;
---

<li>
	<span class="item-title">{item.title}</span>
	<p>{item.description}</p>
	{
		item.links?.length ? (
			<ul class="item-links list-reset" role="list">
				{item.links.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		) : null
	}
</li>

<style>
	.item-title {
		display: block;
		font-weight: var(--weight-semibold);
	}

	/*
	 * Reads at the same small size as the links list below it, so the card's
	 * title is the only thing at body size. Reverses the earlier base-size
	 * call (HZN-19 phase 1.7) on Brandon's 2026-08-05 review.
	 */
	p {
		margin: var(--space-1) 0 0;
		color: var(--muted);
		font-size: var(--text-sm);
	}

	a {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.item-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
		margin: var(--space-2) 0 0;
		font-size: var(--text-sm);
	}
</style>
