---
import type { WorkItem } from "../data/work";

interface Props {
	item: WorkItem;
}

const { item } = Astro.props;
---

<li>
	<span class="item-title">{item.title}</span>
	<p>{item.description}</p>
	{
		item.links?.length ? (
			<ul class="item-links list-reset">
				{item.links.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		) : null
	}
</li>

<style>
	.item-title {
		display: block;
		font-weight: var(--weight-semibold);
	}

	/*
	 * The description is real content, not metadata, so it reads at the base
	 * size rather than the small one. It keeps the muted colour for now; that
	 * is a deliberate half-step, to be settled in the colour pass.
	 */
	p {
		margin: var(--space-1) 0 0;
		color: var(--muted);
	}

	a {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.item-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
		margin: var(--space-2) 0 0;
		font-size: var(--text-sm);
	}
</style>
