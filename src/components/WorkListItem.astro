---
import type { WorkItem } from "../data/work";

interface Props {
	item: WorkItem;
}

const { item } = Astro.props;
---

<li>
	<span class="item-title">{item.title}</span>
	<p>{item.description}</p>
	{
		item.links?.length ? (
			<ul class="item-links">
				{item.links.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		) : null
	}
</li>

<style>
	.item-title {
		display: block;
		font-weight: 600;
	}

	p {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}

	a {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.item-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
		margin: 0.375rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.9375rem;
	}
</style>
