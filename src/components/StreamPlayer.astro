---
import type { Stream } from "../data/streams";
import { broadcastUrl, embedUrl, formatDate } from "../data/streams";

interface Props {
	stream: Stream;
	// Lets the page decide whether this sits on the slim rail or breaks out
	// wide. Layout placement belongs to the page, not to the component.
	class?: string;
}

const { stream, class: className } = Astro.props;
---

<section class={className}>
	<div class="player">
		<iframe
			src={embedUrl(stream.id)}
			title={`Replay: ${stream.title}`}
			allowfullscreen
			loading="lazy"></iframe>
	</div>
	<p class="latest-meta meta">
		<time datetime={stream.date}>{formatDate(stream.date)}</time>
		{" "}&middot; {stream.duration} &middot;{" "}
		<a href={broadcastUrl(stream.id)}>Watch on X</a>
	</p>
</section>

<style>
	/* 16:9 box the player fills, so it is correct from 320px up. */
	.player {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--rule);
	}

	.player iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/*
	 * main's prose-cap rule already limits this to --rail (it's a <p>), but
	 * that alone left it flush against the wide breakout's own left edge.
	 * Centering it lands that --rail box on the slim rail's actual position,
	 * since slim is centered inside wide by construction (global.css). A no-op
	 * when the player isn't in a breakout, since --rail already fills the slim
	 * track with nothing left to center.
	 */
	.latest-meta {
		margin: var(--space-5) auto 0;
	}
</style>
