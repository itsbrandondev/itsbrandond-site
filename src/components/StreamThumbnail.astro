---
import { Image } from "astro:assets";

import type { Stream } from "../data/streams";
import { broadcastUrl, formatDate } from "../data/streams";

interface Props {
	stream: Stream;
}

const { stream } = Astro.props;
---

<li>
	<a href={broadcastUrl(stream.id)}>
		<Image
			src={stream.thumbnail}
			alt=""
			width={544}
			height={306}
			loading="lazy"
			sizes="(min-width: 592px) 544px, calc(100vw - 2 * 1.5rem)"
		/>
		<span>
			<span class="stream-title">{stream.title}</span>
			<span class="stream-meta meta">
				<time datetime={stream.date}>
					{formatDate(stream.date)}
				</time>
				{" · "}
				{stream.duration}
			</span>
		</span>
	</a>
</li>

<style>
	/*
	 * Poster card: still on top, text below, at every size. The card lives in
	 * a grid track, so its width is set by its container rather than by the
	 * window, and there is nothing left for a breakpoint to decide.
	 *
	 * The `sizes` attribute above is the one thing here that must name the
	 * viewport: sizes is resolved before layout, so it cannot ask the
	 * container. 544px is the widest this card ever renders, being the slim
	 * rail it stacks 1-up on; below the rail it fills the viewport less the
	 * two gutters. Move the archive into a breakout and this needs revisiting.
	 */
	a {
		display: block;
		text-decoration: none;
	}

	img {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		margin-bottom: var(--space-3);
		background: var(--rule);
	}

	.stream-title {
		display: block;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.stream-meta {
		display: block;
		margin-top: var(--space-1);
	}
</style>
