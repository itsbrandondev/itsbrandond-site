---
import { Image } from "astro:assets";

import type { Stream } from "../data/streams";
import { broadcastUrl, formatDate } from "../data/streams";

interface Props {
	stream: Stream;
}

const { stream } = Astro.props;
---

<li>
	<a href={broadcastUrl(stream.id)} target="_blank" rel="noopener noreferrer">
		<Image
			src={stream.thumbnail}
			alt=""
			width={128}
			height={72}
			loading="lazy"
			sizes="128px"
		/>
		<span class="stream-info">
			<span class="stream-title">{stream.title}</span>
			<span class="stream-meta meta">
				<time datetime={stream.date}>
					{formatDate(stream.date)}
				</time>
				{" · "}
				{stream.duration}
			</span>
		</span>
	</a>
</li>

<style>
	/*
	 * Compact row: a small fixed-width thumbnail on the left, title and meta
	 * stacked to its right. The thumbnail is a fixed size rather than
	 * container-relative on purpose (compactness is the point), so `sizes`
	 * below is a literal pixel value rather than a viewport expression.
	 */
	a {
		display: flex;
		gap: var(--space-4);
		align-items: flex-start;
		text-decoration: none;
	}

	img {
		width: 8rem;
		flex-shrink: 0;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background: var(--rule);
	}

	.stream-info {
		min-width: 0;
	}

	.stream-title {
		display: block;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.stream-meta {
		display: block;
		margin-top: var(--space-1);
	}
</style>
